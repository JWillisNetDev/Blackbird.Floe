<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Blackbird.Floe.ServiceDefaults\Blackbird.Floe.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Blackbird.Floe.Data\Blackbird.Floe.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fb62a755-d059-4cc9-8ad1-81d5340bb19f</UserSecretsId>
    <OpenApiDocumentsDirectory>../floe-web/openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <!-- Configuration to generate an OpenAPI spec document in the web front-end project -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>../floe-web/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name floe-api</OpenApiGenerateDocumentsOptions>
    <OpenApiGenerationEnvironment>OpenApi</OpenApiGenerationEnvironment>
  </PropertyGroup>

</Project>
